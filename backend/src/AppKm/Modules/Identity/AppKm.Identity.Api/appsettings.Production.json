{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "REPLACE_WITH_PUBLIC_API_HOST",
  "Jwt": {
    "Issuer": "AppKm.Identity.Api",
