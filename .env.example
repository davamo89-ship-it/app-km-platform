# App KM - Production environment template
# Copy values into your hosting platform / secret manager.
# Do not commit real secrets.

ASPNETCORE_ENVIRONMENT=Production

# HTTP host filtering
AllowedHosts=REPLACE_WITH_PUBLIC_API_HOST

# Shared JWT configuration
# Use a cryptographically random secret with at least 32 UTF-8 bytes.
Jwt__Secret=REPLACE_WITH_AT_LEAST_32_BYTE_RANDOM_SECRET

# Identity API
ConnectionStrings__IdentityDatabase=REPLACE_WITH_PRODUCTION_IDENTITY_CONNECTION_STRING
ConnectionStrings__AthleteDatabase=REPLACE_WITH_PRODUCTION_ATHLETE_CONNECTION_STRING

# Athletes API
Firebase__ProjectId=app-km-5e628
# Firebase Admin uses Google Application Default Credentials (ADC).
# GOOGLE_APPLICATION_CREDENTIALS is one supported option when using a service-account file.
GOOGLE_APPLICATION_CREDENTIALS=REPLACE_WITH_SECURE_SERVER_PATH_TO_FIREBASE_SERVICE_ACCOUNT

Strava__ClientId=REPLACE_WITH_STRAVA_CLIENT_ID
Strava__ClientSecret=REPLACE_WITH_STRAVA_CLIENT_SECRET
Strava__RedirectUri=https://REPLACE_WITH_PUBLIC_ATHLETES_HOST/api/v1/athletes/strava/callback
